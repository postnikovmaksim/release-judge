{
  "name": "release-judge",
  "version": "0.1.0",
  "description": "Same-tier release comparator for Radarr: fetches tracker topics, parses MediaInfo/description, compares with the file on disk",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --import tsx 'src/**/*.test.ts'"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "fastify": "^5.2.0",
    "iconv-lite": "^0.6.3",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "undici": "^7.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
